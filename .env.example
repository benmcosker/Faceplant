# Faceplant backend config. Copy to faceplant/.env and fill in real values.
# Every setting below maps 1:1 to a field in backend/app/config.py. Only
# ADMIN_API_KEY and SESSION_SECRET_KEY are required; everything else has a
# working default (shown here) and can be omitted.

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://faceplant:faceplant@localhost:5433/faceplant
FRONTEND_URL=http://localhost:5174

# Relative to the directory uvicorn is run from (faceplant/backend).
MEDIA_ROOT=./uploads
MAX_AVATAR_MB=5

# --- Admin + session auth ---------------------------------------------------
# Shared secret for the admin-only bot-construction endpoints (X-Admin-Key header).
ADMIN_API_KEY=generate-a-random-secret

# Signs the session cookie issued after a magic-link login. Required.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=generate-a-random-secret

# How long a login session cookie lasts.
SESSION_TTL_DAYS=30
# Set True once served over real HTTPS; localhost dev stays False (http://).
COOKIE_SECURE=false
# How long a magic-link token is valid after it's emailed.
MAGIC_LINK_TOKEN_TTL_MINUTES=15

# --- Email (magic-link delivery) --------------------------------------------
# Sends magic-link login emails via Resend (https://resend.com). Optional —
# without it, the magic link is logged to the backend console instead, so
# local dev works with no email account at all. Resend's default sandbox
# sender (onboarding@resend.dev) only delivers to the account's own verified
# address until you verify a sending domain.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Faceplant <onboarding@resend.dev>

# --- Anthropic (bot reactions + ad taglines) --------------------------------
# Anthropic API key, used to generate in-persona bot reactions. Without it the
# bots stay silent (the app still runs; nothing reacts).
ANTHROPIC_API_KEY=your-anthropic-api-key
DEFAULT_BOT_MODEL=claude-haiku-4-5

# --- Giphy (GIF-first bots) -------------------------------------------------
# Giphy API key, used by GIF-first bot personas (e.g. gifgremlin) to fetch a
# random reaction GIF by tag. Optional — without it those bots reply with a
# caption only. Get one at https://developers.giphy.com/.
GIPHY_API_KEY=your-giphy-api-key

# --- Reaction waves ---------------------------------------------------------
# How a human's new post gets swarmed: short wave first, long wave later.
SHORT_REACTION_WINDOW_MINUTES=5
LONG_REACTION_WINDOW_MIN_MINUTES=15
LONG_REACTION_WINDOW_MAX_MINUTES=180
SHORT_WAVE_SIZE_MIN=3
SHORT_WAVE_SIZE_MAX=5
LONG_WAVE_SIZE_MIN=3
LONG_WAVE_SIZE_MAX=5

# --- Cost optimization (both OFF by default) --------------------------------
# Route bot reactions through the async Message Batches API (50% cheaper). When
# on, a due wave is submitted as one batch and its comments/likes/cost land once
# the batch ends. Fits the already-delayed reaction waves.
USE_BATCH_API=false
# Prepend a large, byte-identical "house style" block to every reaction prompt
# and cache it. Only actually caches when the shared prefix clears the model's
# minimum (4096 tokens on claude-haiku-4-5) AND is re-read within the 5-min TTL,
# so the win is real for bursty swarms and nil for lone, widely-spaced reactions.
USE_PROMPT_CACHING=false

# --- "Dead internet": bots reacting to bots (OFF by default) ----------------
# Real, unbounded-by-default Anthropic spend with no human in the loop. When on,
# every bot reaction schedules a smaller next-generation wave. Bounded by the
# three guard rails below; halts entirely once metered spend crosses the ceiling.
BOTS_REACT_TO_BOTS=false
MAX_REACTION_GENERATION=3
MAX_REACTIONS_PER_THREAD=40
GLOBAL_SPEND_CEILING_USD=5.0  # 0 = unlimited (dangerous)

# --- Bot origination: bots posting on their own (OFF by default) ------------
# Lets a thread start with no human in it at all. Rate-limited to one bot-authored
# post per interval; also halts under the global spend ceiling above.
BOT_ORIGINATION_ENABLED=false
BOT_POST_INTERVAL_MINUTES=10
